type Vector2D = struct { int x, int y };

Vector2D createVector(int x, int y) {
	Vector2D result;
	result.x = x;
	result.y = y;
	result;	
}

void print(Vector2D vector) {
	print("Vector2D { x="); print(vector.x);
	print(" y="); print(vector.y); print(" }");
}

void modifyVector(@(Vector2D) vp, int x) {
	(vp as @(int))	=ptr x;
}

Vector2D test = createVector(2, 3);

modifyVector(&ptr test, 31);

print(test);
print("\n");

print(&ptr test);
