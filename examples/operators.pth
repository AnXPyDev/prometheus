int _op_binary ^(int base, int exp) {
	int result = 1;
	loop {
		if (exp <= 0) break;
		exp = exp - 1;
		result = result * base;
	}
	return result;
}

int base = 2;
int i = 0;

loop {
	if (i > 10) break;
	print(base); print(" ^ "); print(i); print(" = ");
	print(base ^ i);
	print("\n");
	
	i = i + 1;
}
