type Vector2D = struct { int x, int y };

void setVector(@(Vector2D) this, int x, int y) {
	this.x =ptr x;
	this.y =ptr y;
}

void print(Vector2D this) {
	print("Vector2D { x=");
	print(this.x);
	print(" y=");
	print(this.y);
	print(" }");
}

Vector2D _op_binary +(Vector2D v1, Vector2D v2) {
	Vector2D result;
	result.x = v1.x + v2.x;
	result.y = v1.y + v2.y;
	return result;
}

Vector2D foo; setVector(&ptr foo, 10, 20);
Vector2D bar; setVector(&ptr bar, 5, 5);

print("foo = "); print(foo); print("\n");
print("bar = "); print(bar); print("\n");

foo = foo + bar;

print("foo = "); print(foo); print("\n");
